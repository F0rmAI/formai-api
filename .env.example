DB_HOST=localhost
DB_PORT=5432
DB_NAME=formai_db
DB_USER=quedena
DB_PASSWORD=                  # obligatorio — sin default

SERVER_PORT=8080

# Clave de firma del JWT propio emitido por el módulo iam (issuer local).
# Generar con: openssl rand -base64 64
JWT_SECRET=                   # obligatorio — sin default
JWT_EXPIRATION_MINUTES=30
# Vigencia del refresh token (cookie httpOnly que renueva el JWT sin volver a iniciar sesión, NFR-007).
JWT_REFRESH_EXPIRATION_DAYS=7

# Origen del frontend que consumirá esta API (necesario para CORS + cookie de sesión).
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Enlace del front para restablecer la contraseña; el token se agrega al final (FR-005).
PASSWORD_RESET_URL=http://localhost:5173/password-reset?token=
# Cada cuánto el despachador envía las notificaciones pendientes (ISO-8601).
NOTIFICATIONS_DISPATCHER_DELAY=PT1M

# Correo transaccional por el relay SMTP de Brevo (US-005). Los valores salen de Brevo:
# SMTP & API > SMTP (usuario y clave SMTP) y Senders (remitente verificado).
# Si quedan vacíos la app arranca igual, pero el correo de restablecimiento no se envía.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FormAI
